{
  "servers": [
    {
      "name": "filesystem",
      "enabled": true,
      "transport": "stdio",
      "description": "Local filesystem MCP server",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/app"
      ],
      "timeout_seconds": 30,
      "env": {}
    },
    {
      "name": "github",
      "enabled": false,
      "transport": "stdio",
      "description": "GitHub MCP server",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "timeout_seconds": 30,
      "env": {
        "GITHUB_TOKEN": "${GITHUB_TOKEN}"
      }
    }
  ]
}
